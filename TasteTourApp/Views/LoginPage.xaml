<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TasteTourApp.Views.LoginPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#161c1a">

    <Grid>
        <!-- Nền -->
        <BoxView Color="#161c1a" VerticalOptions="Fill" HorizontalOptions="Fill" />

        <ScrollView VerticalScrollBarVisibility="Never">
            <!-- Container chính -->
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Fill" Margin="24,48" Spacing="0" MaximumWidthRequest="450">
                
                <!-- Tiêu đề -->
                <Label Text="Taste Tour App" FontSize="32" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" Margin="0,0,0,48" />

                <!-- Thẻ Glassmorphism -->
                <Border BackgroundColor="#14FFFFFF" Stroke="#1AFFFFFF" StrokeThickness="1" StrokeShape="RoundRectangle 32" Padding="24,40">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,10" Radius="20" Opacity="0.4" />
                    </Border.Shadow>
                    
                    <VerticalStackLayout Spacing="24">
                        
                        <!-- Email -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Email Address" TextColor="White" FontSize="14" FontAttributes="Bold" Margin="16,0,0,0" />
                            <Border BackgroundColor="#1AFFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 24" HeightRequest="56" Padding="24,0">
                                <Entry x:Name="EntEmail" Placeholder="name@example.com" PlaceholderColor="#757778" TextColor="White" VerticalOptions="Center" BackgroundColor="Transparent" FontSize="14" Keyboard="Email" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Password -->
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto" Margin="16,0,16,0">
                                <Label Grid.Column="0" Text="Password" TextColor="White" FontSize="14" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="Forgot?" TextColor="#b7e7d2" FontSize="12" VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="QuenMatKhau_Tapped" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                            <Border BackgroundColor="#1AFFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 24" HeightRequest="56" Padding="24,0">
                                <Entry x:Name="EntPassword" Placeholder="••••••••" IsPassword="True" PlaceholderColor="#757778" TextColor="White" VerticalOptions="Center" BackgroundColor="Transparent" FontSize="14" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Nút Đăng nhập -->
                        <Border BackgroundColor="#376454" StrokeThickness="0" StrokeShape="RoundRectangle 28" HeightRequest="56" Margin="0,16,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#376454" Offset="0.0" />
                                    <GradientStop Color="#2b5848" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Shadow>
                                <Shadow Brush="#376454" Offset="0,4" Radius="12" Opacity="0.2" />
                            </Border.Shadow>
                            <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                                <Label Text="Sign In" TextColor="#ccfde8" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                                <Label Text="➔" TextColor="#ccfde8" FontSize="18" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="DangNhap_Tapped" />
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- Đường gạch ngang -->
                        <Grid ColumnDefinitions="*,Auto,*" Margin="0,16" VerticalOptions="Center">
                            <BoxView Grid.Column="0" HeightRequest="1" Color="#1AFFFFFF" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="OR CONTINUE WITH" TextColor="#757778" FontSize="10" CharacterSpacing="1.5" Margin="16,0" VerticalOptions="Center" />
                            <BoxView Grid.Column="2" HeightRequest="1" Color="#1AFFFFFF" VerticalOptions="Center" />
                        </Grid>

                        <!-- Đăng nhập mạng xã hội -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <!-- Nút Google -->
                            <Border Grid.Column="0" BackgroundColor="#0DFFFFFF" Stroke="#1AFFFFFF" StrokeThickness="1" StrokeShape="RoundRectangle 24" HeightRequest="48">
                                <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                                    <Image Source="https://lh3.googleusercontent.com/aida-public/AB6AXuBE_-_DRe4zD-kK_D1Bebl7I1vXtpsX3Mo9wWgJlQSWWyebHknCTE1JZ0JO9TvFJokT_8AFMH5JaG8uOn2hUAIF_Lchht7T1_O_9B5_5UV78z7UQzUmdtltugHfTs3-rYYGsuPQHmp46G2_T4lbdUnMt5yN2POetfxM_bSO1WwyrP3p0pgabSAQ-o1IGgd-oUcNzYBlam7Z6UOMWWlLAzZx0ba-Hq946AYLkt9TZlXzqPc7w8dIsUP9vni1bH7Lh8YjPZPi6Jy5NU5f" WidthRequest="20" HeightRequest="20" />
                                    <Label Text="Google" TextColor="White" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="Google_Tapped" />
                                </Border.GestureRecognizers>
                            </Border>

                            <!-- Nút Apple -->
                            <Border Grid.Column="1" BackgroundColor="#0DFFFFFF" Stroke="#1AFFFFFF" StrokeThickness="1" StrokeShape="RoundRectangle 24" HeightRequest="48">
                                <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                                    <Label Text="🍎" FontSize="16" VerticalOptions="Center" />
                                    <Label Text="Apple" TextColor="White" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="Apple_Tapped" />
                                </Border.GestureRecognizers>
                            </Border>
                        </Grid>

                        <!-- Đăng nhập khách -->
                        <HorizontalStackLayout HorizontalOptions="Center" Margin="0,16,0,0" Spacing="8">
                            <Label Text="Tiếp tục với vai trò khách" TextColor="#dadddf" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Text="👤" TextColor="#dadddf" FontSize="16" VerticalOptions="Center" />
                            <HorizontalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Tapped="Khach_Tapped" />
                            </HorizontalStackLayout.GestureRecognizers>
                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <!-- Footer (Tạo tài khoản) -->
                <HorizontalStackLayout HorizontalOptions="Center" Margin="0,32,0,0" Spacing="4">
                    <Label Text="New to the guide?" TextColor="#757778" FontSize="14" VerticalOptions="Center" />
                    <Label Text="Create Account" TextColor="#b7e7d2" FontSize="14" FontAttributes="Bold" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="TaoTaiKhoan_Tapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TasteTourApp.Views.MainPage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F5F3F0">

    <Grid>

        <!-- ===== LAYER 0: BẢN ĐỒ LEAFLET ===== -->
        <WebView x:Name="BanDoWebView"
                 VerticalOptions="FillAndExpand"
                 HorizontalOptions="FillAndExpand"
                 ZIndex="0"
                 Navigating="BanDoWebView_Navigating" />

        <!-- ===== LAYER 1: THANH TÌM KIẾM ===== -->
        <VerticalStackLayout ZIndex="1" VerticalOptions="Start" Spacing="0">
            <Border BackgroundColor="White" StrokeThickness="0" Padding="16,16,16,14">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="12" Opacity="0.06" />
                </Border.Shadow>

                <!-- Search bar + Avatar trên cùng 1 hàng -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalOptions="Center">

                    <!-- Thanh tìm kiếm -->
                    <Border Grid.Column="0" BackgroundColor="White"
                            StrokeShape="RoundRectangle 16"
                            Stroke="#E8E4DE" StrokeThickness="1" Padding="14,0">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.08" />
                        </Border.Shadow>
                        <Grid ColumnDefinitions="Auto,*,Auto" HeightRequest="48">
                            <Label Grid.Column="0" Text="🔍" VerticalOptions="Center"
                                   FontSize="16" Margin="0,0,8,0" />
                            <Label x:Name="LblSearchPlaceholder" Grid.Column="1"
                                   Text="Tìm quán, địa điểm..."
                                   VerticalOptions="Center" FontSize="14" TextColor="#AAAAAA" />
                            <Border Grid.Column="2" BackgroundColor="#2D6A4F"
                                    StrokeShape="RoundRectangle 10" StrokeThickness="0"
                                    WidthRequest="32" HeightRequest="32" VerticalOptions="Center">
                                <Label Text="🔍" TextColor="White" FontSize="15"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Avatar user -->
                    <Border Grid.Column="1" BackgroundColor="#20b7e7d2" Stroke="#b7e7d2" StrokeThickness="2"
                            StrokeShape="RoundRectangle 24"
                            WidthRequest="48" HeightRequest="48" VerticalOptions="Center">
                        <Label Text="👤" FontSize="20" TextColor="#376454"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>

                </Grid>
            </Border>
        </VerticalStackLayout>

        <!-- ===== FAB: NÚT ĐỊNH VỊ ===== -->
        <Border x:Name="FabLocateMe"
                ZIndex="2"
                VerticalOptions="End" HorizontalOptions="End"
                Margin="0,0,20,300"
                BackgroundColor="White"
                StrokeShape="RoundRectangle 28"
                StrokeThickness="0"
                WidthRequest="56" HeightRequest="56">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,3" Radius="10" Opacity="0.15" />
            </Border.Shadow>
            <Label Text="📍" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="BtnLocateMe_Tapped" />
                </Label.GestureRecognizers>
            </Label>
        </Border>

        <!-- ===== LAYER 2: BOTTOM SHEET DANH SÁCH POI (Draggable) ===== -->
        <Border x:Name="BottomSheetDanhSach"
                ZIndex="3" VerticalOptions="End"
                BackgroundColor="White"
                StrokeShape="RoundRectangle 24,24,0,0"
                StrokeThickness="0"
                Margin="0,0,0,88" Padding="0,12,0,8">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,-6" Radius="24" Opacity="0.12" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="0">

                <!-- Drag Handle (kéo lên/xuống) -->
                <VerticalStackLayout Spacing="0">
                    <BoxView WidthRequest="40" HeightRequest="5" CornerRadius="3"
                             Color="#D0D0D0" HorizontalOptions="Center" Margin="0,0,0,10" />
                    <VerticalStackLayout.GestureRecognizers>
                        <PanGestureRecognizer PanUpdated="BottomSheet_PanUpdated" />
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>

                <!-- Header row -->
                <Grid ColumnDefinitions="*,Auto" Padding="20,0,20,10">
                    <Label Text="ĐIỂM THUYẾT MINH GẦN BẠN"
                           FontSize="11" FontAttributes="Bold" TextColor="#AAAAAA"
                           CharacterSpacing="1.2" VerticalOptions="Center" />
                    <Border Grid.Column="1" BackgroundColor="#E8F5E9"
                            StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="10,4">
                        <Label x:Name="LblPoiCount" Text="0 điểm" FontSize="10"
                               FontAttributes="Bold" TextColor="#2D6A4F" />
                    </Border>
                </Grid>

                <!-- Nearest POI highlight card -->
                <Border x:Name="NearestPoiCard" BackgroundColor="#F0FFF4"
                        StrokeShape="RoundRectangle 16" Stroke="#A7F3D0" StrokeThickness="1.5"
                        Padding="14,12" Margin="16,0,16,10" IsVisible="False">
                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                        <Border Grid.Column="0" BackgroundColor="#2D6A4F" StrokeThickness="0"
                                StrokeShape="RoundRectangle 14" WidthRequest="40" HeightRequest="40"
                                Margin="0,0,12,0">
                            <Label Text="📌" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="Gần bạn nhất" FontSize="9" FontAttributes="Bold"
                                   TextColor="#2D6A4F" CharacterSpacing="0.8" />
                            <Label x:Name="LblNearestName" Text="--" FontSize="14"
                                   FontAttributes="Bold" TextColor="#1A1A1A"
                                   LineBreakMode="TailTruncation" MaxLines="1" />
                            <Label x:Name="LblNearestDistance" Text="-- m" FontSize="11"
                                   TextColor="#666666" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="❯" FontSize="16" TextColor="#2D6A4F"
                               VerticalOptions="Center" />
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="NearestPoi_Tapped" />
                    </Border.GestureRecognizers>
                </Border>

                <!-- POI cards (horizontal scroll) -->
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout x:Name="PoiCardRow" Spacing="12" Padding="16,4,16,4" />
                </ScrollView>
            </VerticalStackLayout>
        </Border>

        <!-- ===== LAYER 3: THẺ CHI TIẾT POI =====
             FIX BLACK SCREEN:
             1. Bỏ Margin bottom — để sheet tự fill từ đáy màn hình lên
             2. Dùng VerticalStackLayout thay Grid Row="*" để tránh collapse
             3. Padding bottom tính sẵn cho nav bar (88px) + safe area
        -->
        <Border x:Name="TheChiTiet"
                ZIndex="5"
                VerticalOptions="End"
                BackgroundColor="White"
                StrokeShape="RoundRectangle 24,24,0,0"
                StrokeThickness="0">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,-4" Radius="24" Opacity="0.15" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="0">

                <!-- Handle + nút đóng -->
                <Grid ColumnDefinitions="*,Auto" Padding="20,14,20,0">
                    <BoxView WidthRequest="40" HeightRequest="4" CornerRadius="2"
                             Color="#DDDDDD"
                             HorizontalOptions="Center" VerticalOptions="Center"
                             Grid.Column="0" />
                    <Border Grid.Column="1"
                            BackgroundColor="#F0F0F0"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="0"
                            WidthRequest="32" HeightRequest="32">
                        <Label x:Name="BtnDongSheet" Text="✕" FontSize="13"
                               TextColor="#666666"
                               HorizontalOptions="Center" VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="BtnDong_Tapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Border>
                </Grid>

                <!-- Hero image placeholder -->
                <Border x:Name="HeroImage"
                        HeightRequest="160"
                        Margin="16,14,16,0"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="0"
                        BackgroundColor="#1B4332">
                    <Grid>
                        <Image x:Name="ImgQuan"
                               Aspect="AspectFill"
                               VerticalOptions="Fill"
                               HorizontalOptions="Fill" />

                        <!-- Lớp tối mờ phía trên ảnh để badge dễ đọc -->
                        <BoxView BackgroundColor="#55000000"
                                 VerticalOptions="End"
                                 HeightRequest="60" />
                        <!-- Badge loại quán -->
                        <Border x:Name="BadgeLoai"
                                BackgroundColor="#2D6A4F"
                                StrokeShape="RoundRectangle 8"
                                StrokeThickness="0"
                                HorizontalOptions="Start"
                                VerticalOptions="End"
                                Padding="10,5"
                                Margin="12,0,0,12">
                            <Label x:Name="LblLoaiQuan"
                                   Text="🦪 Ốc"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Thông tin chính -->
                <VerticalStackLayout Padding="20,14,20,0" Spacing="0">

                    <!-- Tên + rating -->
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,6">
                        <Label x:Name="LblTenQuan"
                               Grid.Column="0"
                               Text="Tên Quán Ăn"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#1A1A1A"
                               LineBreakMode="TailTruncation" />
                        <HorizontalStackLayout Grid.Column="1"
                                               Spacing="3"
                                               Margin="0,0,12,0"
                                               VerticalOptions="Center">
                            <Label Text="★" FontSize="14" TextColor="#F9A825" VerticalOptions="Center" />
                            <Label x:Name="LblRating"
                                   Text="4.5"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#1A1A1A"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        
                        <!-- Nút Yêu thích (Heart) -->
                        <Border Grid.Column="2" 
                                BackgroundColor="#B7E7D2"
                                StrokeShape="RoundRectangle 24"
                                StrokeThickness="0"
                                WidthRequest="36" HeightRequest="36"
                                VerticalOptions="Center">
                            <Label x:Name="BtnHeartPoi" Text="🤍" FontSize="16" TextColor="#376454" HorizontalOptions="Center" VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="BtnHeartPoi_Tapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Border>
                    </Grid>

                    <!-- Địa chỉ -->
                    <HorizontalStackLayout Spacing="5" Margin="0,0,0,10">
                        <Label Text="📍" FontSize="12" VerticalOptions="Center" />
                        <Label x:Name="LblKhoangCach"
                               Text="Vĩnh Khánh, Q.4"
                               FontSize="12" TextColor="#666666"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <!-- Mô tả -->
                    <Label x:Name="LblMoTa"
                           Text="Mô tả quán..."
                           FontSize="13"
                           TextColor="#555555"
                           LineHeight="1.6"
                           MaxLines="2"
                           LineBreakMode="TailTruncation"
                           Margin="0,0,0,14" />

                    <!-- Divider -->
                    <BoxView HeightRequest="1" Color="#F0EDE8" Margin="0,0,0,14" />

                    <!-- Audio player mini -->
                    <Border BackgroundColor="#F8F6F3"
                            StrokeShape="RoundRectangle 14"
                            StrokeThickness="0"
                            Padding="14,12"
                            Margin="0,0,0,14">
                        <Grid ColumnDefinitions="Auto,*,Auto">

                            <!-- Nút Play -->
                            <Border Grid.Column="0"
                                    BackgroundColor="#2D6A4F"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="0"
                                    WidthRequest="42" HeightRequest="42">
                                <Label x:Name="LblPlayIcon"
                                       Text="▶"
                                       FontSize="16"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="BtnPlay_Tapped" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Border>

                            <!-- Thông tin audio -->
                            <VerticalStackLayout Grid.Column="1"
                                                 Padding="12,0,0,0"
                                                 VerticalOptions="Center"
                                                 Spacing="2">
                                <Label x:Name="LblAudioTen"
                                       Text="Thuyết minh"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="#1A1A1A"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1" />
                                <Label x:Name="LblAudioSub"
                                       Text="Tiếng Việt · TTS"
                                       FontSize="11"
                                       TextColor="#AAAAAA" />
                            </VerticalStackLayout>

                        </Grid>
                    </Border>

                </VerticalStackLayout>

                <!-- Action buttons -->
                <Grid ColumnDefinitions="*,2*"
                      Padding="20,0,20,100"
                      ColumnSpacing="10">

                    <Border Grid.Column="0"
                            BackgroundColor="#F0F7F4"
                            StrokeShape="RoundRectangle 14"
                            Stroke="#C8E6D8"
                            StrokeThickness="1.5">
                        <Label Text="🗺️  Chỉ đường"
                               FontSize="13" FontAttributes="Bold"
                               TextColor="#2D6A4F"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Padding="0,16">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="BtnChiDuong_Tapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Border>

                    <Border Grid.Column="1"
                            BackgroundColor="#2D6A4F"
                            StrokeShape="RoundRectangle 14"
                            StrokeThickness="0">
                        <Border.Shadow>
                            <Shadow Brush="#2D6A4F" Offset="0,4" Radius="12" Opacity="0.35" />
                        </Border.Shadow>
                        <Label Text="▶  Nghe thuyết minh"
                               FontSize="13" FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Padding="0,16">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="BtnNgheThuyetMinh_Tapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Border>

                </Grid>

            </VerticalStackLayout>
        </Border>

        <!-- ===== LAYER 4: NAVIGATION BAR ===== -->
        <Border ZIndex="6" VerticalOptions="End" HorizontalOptions="Fill" BackgroundColor="#CCFFFFFF"
                StrokeShape="RoundRectangle 40,40,0,0" StrokeThickness="0"
                Padding="24">
            <Border.Shadow>
                <Shadow Brush="#2E5B4B" Offset="0,-8" Radius="24" Opacity="0.08" />
            </Border.Shadow>

            <Grid ColumnDefinitions="*,*,*,*">

                <!-- Explore (Active) -->
                <Border Grid.Column="0"
                        BackgroundColor="#D1FAE5"
                        StrokeShape="RoundRectangle 20"
                        StrokeThickness="0"
                        Padding="20,8"
                        Scale="1.1"
                        HorizontalOptions="Center" VerticalOptions="Center">
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="EXPLORE" FontSize="10" FontAttributes="Bold" CharacterSpacing="1.5"
                               TextColor="#064E3B" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Tours -->
                <VerticalStackLayout Grid.Column="1"
                                     Padding="20,8"
                                     HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="TOURS" FontSize="10" FontAttributes="Bold" CharacterSpacing="1.5"
                           TextColor="#80065F46" HorizontalOptions="Center" />
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="NavTours_Tapped" />
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>

                <!-- Saved -->
                <VerticalStackLayout Grid.Column="2"
                                     Padding="20,8"
                                     HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="SAVED" FontSize="10" FontAttributes="Bold" CharacterSpacing="1.5"
                           TextColor="#80065F46" HorizontalOptions="Center" />
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="NavSaved_Tapped" />
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>

                <!-- Profile -->
                <VerticalStackLayout Grid.Column="3"
                                     Padding="20,8"
                                     HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="PROFILE" FontSize="10" FontAttributes="Bold" CharacterSpacing="1.5"
                           TextColor="#80065F46" HorizontalOptions="Center" />
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="NavProfile_Tapped" />
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>

            </Grid>
        </Border>

    </Grid>
</ContentPage>

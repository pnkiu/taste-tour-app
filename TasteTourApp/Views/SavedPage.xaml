<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TasteTourApp.Views.SavedPage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F5F6F7">

    <Grid>
        <BoxView Color="#F5F6F7" VerticalOptions="Fill" HorizontalOptions="Fill"/>

        <!-- ===== MAIN CONTENT ===== -->
        <ScrollView VerticalScrollBarVisibility="Never" Margin="0,0,0,88">
            <VerticalStackLayout Padding="24" Spacing="0" Margin="0,64,0,0">

                <!-- Editorial Header -->
                <VerticalStackLayout Spacing="6" Margin="0,0,0,20">
                    <Label Text="Yêu thích" FontSize="32" FontAttributes="Bold" TextColor="#2c2f30"/>
                    <Label Text="Bộ sưu tập ẩm thực cá nhân của bạn"
                           FontSize="15" TextColor="#595c5d" Opacity="0.85"/>
                </VerticalStackLayout>

                <!-- Search Bar -->
                <Border BackgroundColor="#E8EAEB" StrokeShape="RoundRectangle 24"
                        StrokeThickness="0" Padding="16,12" Margin="0,0,0,20">
                    <Grid ColumnDefinitions="Auto,*">
                        <Label Text="🔍" TextColor="#ABADAE" VerticalOptions="Center"
                               Margin="0,0,10,0" FontSize="15"/>
                        <Entry x:Name="SearchEntry" Grid.Column="1"
                               Placeholder="Tìm kiếm trong mục yêu thích..."
                               TextColor="#2C2F30" PlaceholderColor="#ABADAE"
                               BackgroundColor="Transparent" FontSize="14"
                               TextChanged="SearchEntry_TextChanged"/>
                    </Grid>
                </Border>

                <!-- Tab + Count Row -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,20">
                    <Border BackgroundColor="#EFF1F2" StrokeShape="RoundRectangle 24"
                            StrokeThickness="0" Padding="5" HorizontalOptions="Start">
                        <Border BackgroundColor="White" StrokeShape="RoundRectangle 20"
                                StrokeThickness="0" Padding="20,8">
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.06"/>
                            </Border.Shadow>
                            <Label Text="Địa điểm đã lưu" TextColor="#376454"
                                   FontAttributes="Bold" FontSize="13" VerticalOptions="Center"/>
                        </Border>
                    </Border>
                    <Border Grid.Column="1" BackgroundColor="#D1FAE5"
                            StrokeShape="RoundRectangle 12" StrokeThickness="0"
                            Padding="12,6" VerticalOptions="Center">
                        <Label x:Name="LblSavedCount" Text="0 địa điểm"
                               FontSize="11" FontAttributes="Bold" TextColor="#064E3B"/>
                    </Border>
                </Grid>

                <!-- ===== DYNAMIC SAVED CARDS ===== -->
                <!-- Cards được render từ code-behind (RenderSavedCards) -->
                <VerticalStackLayout x:Name="SavedCardStack" Spacing="16"/>

                <!-- Empty View (hiện khi không có item) -->
                <VerticalStackLayout x:Name="EmptyView" IsVisible="False"
                                     HorizontalOptions="Center"
                                     Margin="0,60,0,0" Spacing="16">
                    <Border BackgroundColor="#E8F5E9" StrokeThickness="0"
                            StrokeShape="RoundRectangle 40"
                            WidthRequest="80" HeightRequest="80"
                            HorizontalOptions="Center">
                        <Label Text="🤍" FontSize="36"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Label Text="Chưa có địa điểm nào được lưu"
                           FontSize="17" FontAttributes="Bold"
                           TextColor="#2c2f30" HorizontalOptions="Center"/>
                    <Label Text="Nhấn biểu tượng ❤️ trên trang chi tiết để lưu địa điểm yêu thích"
                           FontSize="13" TextColor="#595c5d" Opacity="0.8"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center"
                           LineHeight="1.5"/>
                </VerticalStackLayout>

                <!-- Bottom padding -->
                <BoxView HeightRequest="24" Color="Transparent"/>
            </VerticalStackLayout>
        </ScrollView>

        <!-- ===== TOP APP BAR ===== -->
        <Border ZIndex="5" VerticalOptions="Start" HorizontalOptions="Fill"
                BackgroundColor="#E6FFFFFF" StrokeThickness="0" HeightRequest="64">
            <Border.Shadow>
                <Shadow Brush="#064E3B" Offset="0,2" Radius="8" Opacity="0.05"/>
            </Border.Shadow>
            <Grid Padding="24,0" ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <Label Text="Taste Tour App" FontSize="20" FontAttributes="Bold, Italic"
                       TextColor="#064E3B" VerticalOptions="Center"/>
                <Border Grid.Column="1" BackgroundColor="#20b7e7d2" Stroke="#b7e7d2"
                        StrokeThickness="2" StrokeShape="RoundRectangle 20"
                        WidthRequest="40" HeightRequest="40" VerticalOptions="Center">
                    <Label Text="🔍" FontSize="16" TextColor="#064E3B"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- ===== NAVIGATION BAR ===== -->
        <Border ZIndex="4" VerticalOptions="End" HorizontalOptions="Fill"
                BackgroundColor="#CCFFFFFF"
                StrokeShape="RoundRectangle 40,40,0,0"
                StrokeThickness="0" Padding="24">
            <Border.Shadow>
                <Shadow Brush="#2E5B4B" Offset="0,-8" Radius="24" Opacity="0.08"/>
            </Border.Shadow>
            <Grid ColumnDefinitions="*,*,*,*">

                <!-- Explore -->
                <VerticalStackLayout Grid.Column="0" Padding="20,8"
                                     HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="EXPLORE" FontSize="10" FontAttributes="Bold"
                           CharacterSpacing="1.5" TextColor="#80065F46"
                           HorizontalOptions="Center"/>
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="NavHome_Tapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>

                <!-- Tours -->
                <VerticalStackLayout Grid.Column="1" Padding="20,8"
                                     HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="TOURS" FontSize="10" FontAttributes="Bold"
                           CharacterSpacing="1.5" TextColor="#80065F46"
                           HorizontalOptions="Center"/>
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="NavTours_Tapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>

                <!-- Saved (Active) -->
                <Border Grid.Column="2" BackgroundColor="#D1FAE5"
                        StrokeShape="RoundRectangle 20" StrokeThickness="0"
                        Padding="20,8" Scale="1.1"
                        HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="SAVED" FontSize="10" FontAttributes="Bold"
                           CharacterSpacing="1.5" TextColor="#064E3B"
                           HorizontalOptions="Center"/>
                </Border>

                <!-- Profile -->
                <VerticalStackLayout Grid.Column="3" Padding="20,8"
                                     HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="PROFILE" FontSize="10" FontAttributes="Bold"
                           CharacterSpacing="1.5" TextColor="#80065F46"
                           HorizontalOptions="Center"/>
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="NavProfile_Tapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>

            </Grid>
        </Border>

    </Grid>
</ContentPage>

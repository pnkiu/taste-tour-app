<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TasteTourApp.Views.TourPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#f5f6f7">

    <Grid>

        <ScrollView VerticalScrollBarVisibility="Never" Margin="0,0,0,88">
            <VerticalStackLayout Spacing="0">

                <!-- ===== HERO SECTION ===== -->
                <Grid HeightRequest="380">
                    <!-- Background gradient -->
                    <BoxView BackgroundColor="#1B4332" />

                    <!-- Overlay content -->
                    <VerticalStackLayout VerticalOptions="End" Padding="24,0,24,32" Spacing="12">

                        <!-- Badge -->
                        <Border BackgroundColor="#336942bd" StrokeThickness="0" StrokeShape="RoundRectangle 16"
                                Padding="12,5" HorizontalOptions="Start">
                            <Label Text="✨  KHÁM PHÁ NGAY" TextColor="#f8f0ff" FontSize="9"
                                   FontAttributes="Bold" CharacterSpacing="1.5" />
                        </Border>

                        <!-- Title -->
                        <Label Text="Khám phá hương vị&#x0a;di sản qua từng&#x0a;câu chuyện"
                               FontSize="30" FontAttributes="Bold" TextColor="White"
                               LineHeight="1.1" />

                        <!-- CTA Button -->
                        <Border BackgroundColor="#2D6A4F" StrokeThickness="0" StrokeShape="RoundRectangle 28"
                                Padding="24,14" HorizontalOptions="Start" Margin="0,4,0,0">
                            <Border.Shadow>
                                <Shadow Brush="#2D6A4F" Offset="0,4" Radius="12" Opacity="0.35" />
                            </Border.Shadow>
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <Label Text="🧭" FontSize="16" VerticalOptions="Center" />
                                <Label Text="Bắt đầu hành trình" TextColor="White" FontSize="14"
                                       FontAttributes="Bold" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="BtnBatDau_Tapped" />
                            </Border.GestureRecognizers>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Top bar overlay -->
                    <Grid VerticalOptions="Start" Padding="24,16" ColumnDefinitions="*,Auto">
                        <Label Text="Taste Tour App" FontSize="22" FontAttributes="Bold"
                               TextColor="White" VerticalOptions="Center" />
                        <Border Grid.Column="1" BackgroundColor="#33ffffff" StrokeThickness="0"
                                StrokeShape="RoundRectangle 20" WidthRequest="40" HeightRequest="40">
                            <Label Text="🔔" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </Grid>

                <!-- ===== TOUR NỔI BẬT ===== -->
                <VerticalStackLayout Padding="24,32,24,0" Spacing="0">

                    <!-- Section header -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,20">
                        <VerticalStackLayout>
                            <Label Text="Tour Nổi Bật" FontSize="22" FontAttributes="Bold" TextColor="#2b5848" />
                            <Label Text="Được đề xuất dành riêng cho bạn" FontSize="12" TextColor="#595c5d" Margin="0,2,0,0" />
                        </VerticalStackLayout>
                        <HorizontalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="Xem tất cả" FontSize="12" FontAttributes="Bold" TextColor="#376454" VerticalOptions="Center" />
                            <Label Text="❯" FontSize="10" TextColor="#376454" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Grid>
                </VerticalStackLayout>

                <!-- Horizontal tour cards -->
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,0,0,0">
                    <HorizontalStackLayout Spacing="16" Padding="24,0,24,8">

                        <!-- Tour Card 1 -->
                        <Border WidthRequest="260" HeightRequest="340" StrokeThickness="0"
                                StrokeShape="RoundRectangle 20" BackgroundColor="#1B4332">
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,4" Radius="16" Opacity="0.12" />
                            </Border.Shadow>
                            <Grid>
                                <!-- Card background color -->
                                <BoxView BackgroundColor="#1B4332" />

                                <!-- Decorative circle -->
                                <Border BackgroundColor="#2D6A4F" StrokeThickness="0" StrokeShape="RoundRectangle 80"
                                        WidthRequest="160" HeightRequest="160" Opacity="0.3"
                                        HorizontalOptions="End" VerticalOptions="Start" Margin="0,-30,-30,0" />

                                <!-- Top badge -->
                                <Border BackgroundColor="#33ffffff" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                        Padding="10,5" HorizontalOptions="End" VerticalOptions="Start" Margin="0,16,16,0">
                                    <HorizontalStackLayout Spacing="4">
                                        <Label Text="🎧" FontSize="11" VerticalOptions="Center" />
                                        <Label Text="Audio Guide" TextColor="White" FontSize="10"
                                               FontAttributes="Bold" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>

                                <!-- Emoji focal point -->
                                <Label Text="🦪" FontSize="56" HorizontalOptions="Center" VerticalOptions="Center"
                                       Margin="0,0,0,40" Opacity="0.9" />

                                <!-- Bottom info -->
                                <VerticalStackLayout VerticalOptions="End" Padding="20,0,20,24" Spacing="6">
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="🕐" FontSize="11" VerticalOptions="Center" />
                                        <Label Text="2 giờ" TextColor="#b7e7d2" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                                        <Label Text="·" TextColor="#b7e7d2" FontSize="11" VerticalOptions="Center" />
                                        <Label Text="5 điểm" TextColor="#b7e7d2" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <Label Text="Tour Ẩm thực đêm&#x0a;Quận 4" FontSize="20" FontAttributes="Bold"
                                           TextColor="White" LineHeight="1.15" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <!-- Tour Card 2 -->
                        <Border WidthRequest="260" HeightRequest="340" StrokeThickness="0"
                                StrokeShape="RoundRectangle 20" BackgroundColor="#1A3A5C">
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,4" Radius="16" Opacity="0.12" />
                            </Border.Shadow>
                            <Grid>
                                <BoxView BackgroundColor="#1A3A5C" />
                                <Border BackgroundColor="#2A5A8C" StrokeThickness="0" StrokeShape="RoundRectangle 80"
                                        WidthRequest="160" HeightRequest="160" Opacity="0.3"
                                        HorizontalOptions="End" VerticalOptions="Start" Margin="0,-30,-30,0" />

                                <Border BackgroundColor="#33ffffff" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                        Padding="10,5" HorizontalOptions="End" VerticalOptions="Start" Margin="0,16,16,0">
                                    <HorizontalStackLayout Spacing="4">
                                        <Label Text="🎧" FontSize="11" VerticalOptions="Center" />
                                        <Label Text="Audio Guide" TextColor="White" FontSize="10"
                                               FontAttributes="Bold" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>

                                <Label Text="☕" FontSize="56" HorizontalOptions="Center" VerticalOptions="Center"
                                       Margin="0,0,0,40" Opacity="0.9" />

                                <VerticalStackLayout VerticalOptions="End" Padding="20,0,20,24" Spacing="6">
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="🕐" FontSize="11" VerticalOptions="Center" />
                                        <Label Text="1.5 giờ" TextColor="#aec5ee" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                                        <Label Text="·" TextColor="#aec5ee" FontSize="11" VerticalOptions="Center" />
                                        <Label Text="4 điểm" TextColor="#aec5ee" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <Label Text="Hành trình Café&#x0a;Phố cổ" FontSize="20" FontAttributes="Bold"
                                           TextColor="White" LineHeight="1.15" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <!-- Tour Card 3 -->
                        <Border WidthRequest="260" HeightRequest="340" StrokeThickness="0"
                                StrokeShape="RoundRectangle 20" BackgroundColor="#4A1942">
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,4" Radius="16" Opacity="0.12" />
                            </Border.Shadow>
                            <Grid>
                                <BoxView BackgroundColor="#4A1942" />
                                <Border BackgroundColor="#6942bd" StrokeThickness="0" StrokeShape="RoundRectangle 80"
                                        WidthRequest="160" HeightRequest="160" Opacity="0.3"
                                        HorizontalOptions="End" VerticalOptions="Start" Margin="0,-30,-30,0" />

                                <Border BackgroundColor="#33ffffff" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                        Padding="10,5" HorizontalOptions="End" VerticalOptions="Start" Margin="0,16,16,0">
                                    <HorizontalStackLayout Spacing="4">
                                        <Label Text="🎧" FontSize="11" VerticalOptions="Center" />
                                        <Label Text="Audio Guide" TextColor="White" FontSize="10"
                                               FontAttributes="Bold" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>

                                <Label Text="🍜" FontSize="56" HorizontalOptions="Center" VerticalOptions="Center"
                                       Margin="0,0,0,40" Opacity="0.9" />

                                <VerticalStackLayout VerticalOptions="End" Padding="20,0,20,24" Spacing="6">
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="🕐" FontSize="11" VerticalOptions="Center" />
                                        <Label Text="3 giờ" TextColor="#bea1ff" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                                        <Label Text="·" TextColor="#bea1ff" FontSize="11" VerticalOptions="Center" />
                                        <Label Text="8 điểm" TextColor="#bea1ff" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <Label Text="Phở &amp; Bún qua&#x0a;các thế hệ" FontSize="20" FontAttributes="Bold"
                                           TextColor="White" LineHeight="1.15" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                    </HorizontalStackLayout>
                </ScrollView>

                <!-- ===== KHÁM PHÁ THEO TUYẾN ===== -->
                <VerticalStackLayout Padding="24,36,24,0" Spacing="12">
                    <Label Text="Khám Phá Theo Tuyến" FontSize="22" FontAttributes="Bold" TextColor="#2b5848" Margin="0,0,0,4" />

                    <!-- Route 1: Full width -->
                    <Border BackgroundColor="#ffffff" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="20">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.05" />
                        </Border.Shadow>
                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                            <Border Grid.Column="0" BackgroundColor="#4Db7e7d2" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 28" WidthRequest="56" HeightRequest="56" Margin="0,0,16,0">
                                <Label Text="🏛️" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="Phố cổ Hà Nội" FontSize="15" FontAttributes="Bold" TextColor="#2c2f30" />
                                <Label Text="12 điểm dừng chân · Audio guide" FontSize="11" TextColor="#595c5d" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="❯" FontSize="16" TextColor="#abadae" VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- Route 2 + 3: Grid -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

                        <!-- Route 2 -->
                        <Border Grid.Column="0" BackgroundColor="#ffffff" StrokeThickness="0"
                                StrokeShape="RoundRectangle 16" Padding="20,24">
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.05" />
                            </Border.Shadow>
                            <VerticalStackLayout Spacing="12">
                                <Border BackgroundColor="#4Dbbd3fd" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 24" WidthRequest="48" HeightRequest="48"
                                        HorizontalOptions="Start">
                                    <Label Text="🏪" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Chợ Bến Thành" FontSize="14" FontAttributes="Bold" TextColor="#2c2f30" />
                                    <Label Text="Sài Gòn nhộn nhịp" FontSize="11" TextColor="#595c5d" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Route 3 -->
                        <Border Grid.Column="1" BackgroundColor="#ffffff" StrokeThickness="0"
                                StrokeShape="RoundRectangle 16" Padding="20,24">
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.05" />
                            </Border.Shadow>
                            <VerticalStackLayout Spacing="12">
                                <Border BackgroundColor="#4Dbea1ff" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 24" WidthRequest="48" HeightRequest="48"
                                        HorizontalOptions="Start">
                                    <Label Text="🚶" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Hẻm nhỏ Sài Gòn" FontSize="14" FontAttributes="Bold" TextColor="#2c2f30" />
                                    <Label Text="Ký ức đô thị" FontSize="11" TextColor="#595c5d" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Route 4 + 5: Grid -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,0,0,24">

                        <Border Grid.Column="0" BackgroundColor="#ffffff" StrokeThickness="0"
                                StrokeShape="RoundRectangle 16" Padding="20,24">
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.05" />
                            </Border.Shadow>
                            <VerticalStackLayout Spacing="12">
                                <Border BackgroundColor="#4Dfb5151" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 24" WidthRequest="48" HeightRequest="48"
                                        HorizontalOptions="Start">
                                    <Label Text="🌶️" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Ẩm thực cay Huế" FontSize="14" FontAttributes="Bold" TextColor="#2c2f30" />
                                    <Label Text="Cung đình đến dân dã" FontSize="11" TextColor="#595c5d" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" BackgroundColor="#ffffff" StrokeThickness="0"
                                StrokeShape="RoundRectangle 16" Padding="20,24">
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.05" />
                            </Border.Shadow>
                            <VerticalStackLayout Spacing="12">
                                <Border BackgroundColor="#4D2D6A4F" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 24" WidthRequest="48" HeightRequest="48"
                                        HorizontalOptions="Start">
                                    <Label Text="🍲" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Phở Hà Nội" FontSize="14" FontAttributes="Bold" TextColor="#2c2f30" />
                                    <Label Text="Tinh hoa ẩm thực" FontSize="11" TextColor="#595c5d" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ===== MINI PLAYER (Narrator) ===== -->
        <Border x:Name="MiniPlayer" ZIndex="4" VerticalOptions="End" HorizontalOptions="Fill"
                BackgroundColor="#1B4332" StrokeThickness="0" StrokeShape="RoundRectangle 16"
                Margin="16,0,16,100" Padding="12" IsVisible="False">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,4" Radius="16" Opacity="0.2" />
            </Border.Shadow>
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" VerticalOptions="Center">
                <!-- Thumbnail -->
                <Border Grid.Column="0" BackgroundColor="#2D6A4F" StrokeThickness="0"
                        StrokeShape="RoundRectangle 10" WidthRequest="44" HeightRequest="44">
                    <Label Text="🦪" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <!-- Info -->
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                    <Label Text="ĐANG NGHE DỞ" TextColor="#b7e7d2" FontSize="8"
                           FontAttributes="Bold" CharacterSpacing="1" />
                    <Label x:Name="LblMiniTitle" Text="Ẩm thực đêm Q.4 - Ốc Đào"
                           TextColor="White" FontSize="12" FontAttributes="Bold"
                           LineBreakMode="TailTruncation" MaxLines="1" />
                </VerticalStackLayout>
                <!-- Play -->
                <Border Grid.Column="2" BackgroundColor="#2D6A4F" StrokeThickness="0"
                        StrokeShape="RoundRectangle 18" WidthRequest="36" HeightRequest="36">
                    <Label Text="▶" FontSize="14" TextColor="White"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <!-- Close -->
                <Label Grid.Column="3" Text="✕" FontSize="14" TextColor="#80b7e7d2"
                       VerticalOptions="Center" Margin="4,0,4,0">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="BtnCloseMini_Tapped" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>
        </Border>

        <!-- ===== NAVIGATION BAR ===== -->
        <Border ZIndex="5" VerticalOptions="End" HorizontalOptions="Fill" BackgroundColor="#CCFFFFFF"
                StrokeShape="RoundRectangle 40,40,0,0" StrokeThickness="0"
                Padding="24">
            <Border.Shadow>
                <Shadow Brush="#2E5B4B" Offset="0,-8" Radius="24" Opacity="0.08" />
            </Border.Shadow>

            <Grid ColumnDefinitions="*,*,*,*">

                <!-- Explore -->
                <VerticalStackLayout Grid.Column="0"
                                     Padding="20,8"
                                     HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="EXPLORE" FontSize="10" FontAttributes="Bold" CharacterSpacing="1.5"
                           TextColor="#80065F46" HorizontalOptions="Center" />
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="NavExplore_Tapped" />
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>

                <!-- Tours (Active) -->
                <Border Grid.Column="1"
                        BackgroundColor="#D1FAE5"
                        StrokeShape="RoundRectangle 20"
                        StrokeThickness="0"
                        Padding="20,8"
                        Scale="1.1"
                        HorizontalOptions="Center" VerticalOptions="Center">
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="TOURS" FontSize="10" FontAttributes="Bold" CharacterSpacing="1.5"
                               TextColor="#064E3B" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Saved -->
                <VerticalStackLayout Grid.Column="2"
                                     Padding="20,8"
                                     HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="SAVED" FontSize="10" FontAttributes="Bold" CharacterSpacing="1.5"
                           TextColor="#80065F46" HorizontalOptions="Center" />
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="NavSaved_Tapped" />
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>

                <!-- Profile -->
                <VerticalStackLayout Grid.Column="3"
                                     Padding="20,8"
                                     HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="PROFILE" FontSize="10" FontAttributes="Bold" CharacterSpacing="1.5"
                           TextColor="#80065F46" HorizontalOptions="Center" />
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="NavProfile_Tapped" />
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>

            </Grid>
        </Border>

    </Grid>
</ContentPage>

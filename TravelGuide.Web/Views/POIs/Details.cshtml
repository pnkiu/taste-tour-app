@model TravelGuide.Web.Models.POI

@{
    ViewData["Title"] = "Chi tiết Địa điểm";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Địa điểm: <span class="text-primary font-weight-bold">@Model.Name</span></h1>
    <div>
        <a asp-action="Index" class="d-none d-sm-inline-block btn btn-sm btn-secondary shadow-sm">
            <i class="fas fa-arrow-left fa-sm text-white-50"></i> Quay lại Danh sách
        </a>
    </div>
</div>

<div class="row">
    <div class="col-xl-8 col-lg-7">
        <div class="card shadow mb-4 border-bottom-primary">
            <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-map-marker-alt"></i> Thông tin Địa điểm (POI)</h6>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-sm shadow-sm">
                    <i class="fas fa-edit"></i> Sửa thông tin
                </a>
            </div>
            <div class="card-body">
                <div class="row mb-3 align-items-center">
                    <div class="col-md-4 font-weight-bold text-dark">Tên quán / Địa điểm:</div>
                    <div class="col-md-8 text-primary font-weight-bold" style="font-size: 1.1rem;">@Model.Name</div>
                </div>
                <hr>
                <div class="row mb-3">
                    <div class="col-md-4 font-weight-bold text-dark">Mô tả chi tiết:</div>
                    <div class="col-md-8 text-justify text-muted">
                        @(string.IsNullOrEmpty(Model.Description) ? "Chưa có đoạn mô tả nào cho địa điểm này." : Model.Description)
                    </div>
                </div>
                <hr>
                
                <div class="row mb-3 align-items-center">
                    <div class="col-md-4 font-weight-bold text-dark"><i class="fas fa-crosshairs text-danger mr-1"></i> Tọa độ GPS:</div>
                    <div class="col-md-8 d-flex align-items-center">
                        <span class="badge badge-light border border-secondary px-3 py-2 text-dark mr-2" style="font-size: 0.9rem;">
                            @Model.Latitude, @Model.Longitude
                        </span>
                        @if (Model.Latitude != 0 && Model.Longitude != 0)
                        {
                            <a href="https://www.google.com/maps/search/?api=1&query=@Model.Latitude,@Model.Longitude" target="_blank" class="btn btn-sm btn-outline-info">
                                <i class="fas fa-map"></i> Xem Google Maps
                            </a>
                        }
                    </div>
                </div>
                <hr>

                <div class="row mb-3 align-items-center">
                    <div class="col-md-4 font-weight-bold text-dark"><i class="fas fa-bullseye text-success mr-1"></i> Bán kính kích hoạt:</div>
                    <div class="col-md-8">
                        <span class="badge badge-success px-3 py-2" style="font-size: 0.9rem;">@Model.Radius mét</span>
                        <small class="text-muted ml-2">(Khoảng cách để App tự động phát Audio)</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-4 col-lg-5">
        <div class="card shadow mb-4 border-bottom-success">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-success"><i class="fas fa-image"></i> Ảnh đại diện</h6>
            </div>
            <div class="card-body text-center bg-gray-100">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="POI Image" class="img-fluid rounded shadow-sm mb-3" style="max-height: 300px; width: 100%; object-fit: cover; border: 3px solid white;" />
                    <a href="@Model.ImageUrl" target="_blank" class="btn btn-sm btn-outline-primary"><i class="fas fa-external-link-alt"></i> Xem ảnh gốc HD</a>
                }
                else
                {
                    <img src="https://via.placeholder.com/400x300?text=Chua+co+anh" alt="No Image" class="img-fluid rounded shadow-sm mb-3" style="max-height: 300px; width: 100%; object-fit: cover; border: 3px solid white;" />
                    <p class="text-muted small mb-0"><i class="fas fa-exclamation-triangle text-warning"></i> Địa điểm này chưa có hình ảnh minh họa.</p>
                }
            </div>
        </div>
    </div>
</div>
@model IEnumerable<TravelGuide.Web.Models.POI>

@{
    ViewData["Title"] = "Quản lý POI";
}

<h1 class="h3 mb-2 text-gray-800">Quản lý Điểm thuyết minh (POI)</h1>
<p class="mb-4">Quản lý danh sách các địa điểm, tọa độ và bán kính kích hoạt Geofencing cho App Mobile.</p>

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
        <h6 class="m-0 font-weight-bold text-primary">Dữ liệu Địa điểm</h6>
        <a asp-action="Create" class="btn btn-sm btn-success shadow-sm">
            <i class="fas fa-plus fa-sm text-white-50"></i> Thêm mới POI
        </a>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover" id="dataTable" width="100%" cellspacing="0">
                <thead class="thead-light">
                    <tr>
                        <th>Tên địa điểm</th>
                        <th>Tọa độ (Lat / Lng)</th>
                        <th>Bán kính</th>
                        <th>Mức ưu tiên</th>
                        <th>Hành động</th>
                        <th>Nằm trong Tour</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="font-weight-bold text-dark align-middle">@item.Name</td>
                            <td class="align-middle"><span class="badge badge-info">@item.Latitude, @item.Longitude</span></td>
                            <td class="align-middle">@item.Radius m</td>
                            <td class="align-middle">@item.Priority</td>
    
                            <td class="align-middle">
                                @if (item.TourPOIs != null && item.TourPOIs.Any())
                                {
                                    foreach (var tourPoi in item.TourPOIs)
                                    {
                                        <span class="badge badge-primary mb-1" style="font-size: 13px;">
                                            <i class="fas fa-route"></i> @tourPoi.Tour?.Name
                                        </span>
                                        <br />
                                    }
                                }
                                else
                                {
                                    <span class="text-muted text-xs">Chưa có Tour</span>
                                }
                            </td>

                            <td class="align-middle text-center">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-circle btn-sm" title="Sửa">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-circle btn-sm" title="Xem chi tiết">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-circle btn-sm" title="Xóa">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/vendor/datatables/jquery.dataTables.min.js"></script>
    <script src="~/vendor/datatables/dataTables.bootstrap4.min.js"></script>
    <link href="~/vendor/datatables/dataTables.bootstrap4.min.css" rel="stylesheet">

        <script>
            $(document).ready(function() {
                // Biến cái bảng bình thường thành DataTables và Việt hóa nó
                $('#dataTable').DataTable({
                    "language": {
                        "url": "//cdn.datatables.net/plug-ins/1.10.24/i18n/Vietnamese.json"
                    }
                });
            });
        </script>
    }
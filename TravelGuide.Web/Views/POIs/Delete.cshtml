@model TravelGuide.Web.Models.POI

@{
    ViewData["Title"] = "Xóa Địa điểm";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow border-0" style="border-radius: 25px; overflow: hidden;">
                
                <div class="card-header bg-white py-4 d-flex align-items-center" style="border-bottom: 2px solid #f8d7da;">
                    <div class="icon-circle bg-danger text-white mr-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px; border-radius: 15px; box-shadow: 0 5px 15px rgba(220, 53, 69, 0.3);">
                        <i class="fas fa-trash-alt fa-lg text-white"></i>
                    </div>
                    <div>
                        <h4 class="m-0 font-weight-bold text-danger">Xóa Địa điểm (POI)</h4>
                        <small class="text-muted">Kiểm tra kỹ thông tin trước khi xóa vĩnh viễn.</small>
                    </div>
                </div>
                
                <div class="card-body p-5 bg-light">
                    <div class="alert alert-danger mb-4 shadow-sm" style="border-radius: 15px;">
                        <i class="fas fa-exclamation-triangle mr-2"></i> <strong>Cảnh báo:</strong> Bạn có chắc chắn muốn xóa quán ăn/địa điểm này không? Hành động này sẽ gỡ địa điểm khỏi tất cả các Tour liên quan và không thể hoàn tác!
                    </div>

                    <div class="row">
                        <div class="col-md-5 mb-4 mb-md-0">
                            <div class="p-3 rounded-lg shadow-inner text-center h-100" style="background-color: #fff; border-radius: 20px; box-shadow: inset 0 2px 10px rgba(0,0,0,0.05); border: 1px solid #e1e5eb;">
                                <label class="font-weight-bold text-muted d-block text-center mb-3" style="font-size: 1rem; letter-spacing: 1px;">
                                    <i class="fas fa-image text-danger mr-2"></i>HÌNH ẢNH ĐỊA ĐIỂM
                                </label>
                                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                                {
                                    <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid rounded" style="max-height: 300px; object-fit: cover; border-radius: 15px;" />
                                }
                                else
                                {
                                    <div class="d-flex align-items-center justify-content-center flex-column" style="height: 200px; background-color: #f8f9fa; border-radius: 15px;">
                                        <i class="fas fa-store-alt text-muted fa-3x mb-2" style="opacity: 0.3;"></i>
                                        <span class="text-muted font-italic">Chưa cập nhật hình ảnh</span>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="col-md-7">
                            <div class="p-4 rounded-lg h-100" style="background-color: #fff; border-radius: 20px; border: 1px solid #e1e5eb;">
                                <h5 class="font-weight-bold text-dark border-bottom pb-2 mb-3">@Model.Name</h5>
                                
                                <dl class="row mb-0">
                                    <dt class="col-sm-4 font-weight-bold h6 text-dark mb-3"><i class="fas fa-map-marker-alt text-danger mr-2"></i>Tọa độ GPS:</dt>
                                    <dd class="col-sm-8 h6 text-muted mb-3">
                                        <span class="badge badge-light border p-2">Lat: @Model.Latitude</span>
                                        <span class="badge badge-light border p-2">Lng: @Model.Longitude</span>
                                    </dd>

                                    <dt class="col-sm-4 font-weight-bold h6 text-dark mb-3"><i class="fas fa-broadcast-tower text-primary mr-2"></i>Bán kính (m):</dt>
                                    <dd class="col-sm-8 h6 text-muted mb-3">@Model.Radius mét</dd>

                                    <dt class="col-sm-4 font-weight-bold h6 text-dark mb-3"><i class="fas fa-star text-warning mr-2"></i>Độ ưu tiên:</dt>
                                    <dd class="col-sm-8 h6 text-muted mb-3">@Model.Priority</dd>

                                    <dt class="col-sm-4 font-weight-bold h6 text-dark mb-3"><i class="fas fa-info-circle text-info mr-2"></i>Mô tả:</dt>
                                    <dd class="col-sm-8 h6 text-muted mb-3" style="max-height: 80px; overflow-y: auto;">
                                        @(string.IsNullOrEmpty(Model.Description) ? "Không có mô tả" : Model.Description)
                                    </dd>
                                    
                                    @if (!string.IsNullOrEmpty(Model.MapLink))
                                    {
                                        <dt class="col-sm-4 font-weight-bold h6 text-dark mb-3"><i class="fas fa-external-link-alt text-success mr-2"></i>Google Maps:</dt>
                                        <dd class="col-sm-8 h6 text-muted mb-3">
                                            <a href="@Model.MapLink" target="_blank" class="text-primary text-truncate d-inline-block" style="max-width: 100%;">Xem trên bản đồ</a>
                                        </dd>
                                    }
                                </dl>
                            </div>
                        </div>
                    </div>

                    <hr style="border-top: 2px dashed #e1e5eb; margin-top: 2rem;" />
                    
                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        
                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-secondary btn-lg" style="opacity: 0.8; border-radius: 12px;">
                                <i class="fas fa-arrow-left mr-2"></i>Hủy bỏ
                            </a>
                            <button type="submit" class="btn btn-danger btn-lg text-white font-weight-bold" style="background: linear-gradient(45deg, #e74a3b, #e02d1b); border: none; border-radius: 12px; box-shadow: 0 4px 10px rgba(220, 53, 69, 0.3);">
                                <i class="fas fa-trash-alt mr-2"></i>Xác nhận Xóa
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
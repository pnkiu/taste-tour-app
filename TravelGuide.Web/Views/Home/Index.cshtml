@model dynamic
@{
    ViewData["Title"] = "TasteTour - Admin Dashboard";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div class="d-flex flex-column" style="min-height: calc(100vh - 170px);">

    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800 font-weight-bold">Bảng điều khiển hệ thống</h1>
        <a href="/swagger" target="_blank" class="btn btn-sm btn-primary shadow-sm">
            <i class="fas fa-code fa-sm text-white-50"></i> Kiểm tra API
        </a>
    </div>

    <div class="row">
        <div class="col-xl-4 col-md-6 mb-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Tổng số Địa điểm (POI)</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@ViewBag.TotalPOIs</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-map-marker-alt fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-6 mb-4">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Thiết bị đang dùng App</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="totalActiveDevices">0</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-mobile-alt fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-6 mb-4">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Hành trình (Tours)</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@ViewBag.TotalTours</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-route fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        
        <div class="col-lg-8 mb-4 mb-lg-0">
            <div class="card shadow h-100">
                <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                    <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-users mr-2"></i>Danh sách thiết bị trực tuyến</h6>
                    <span class="badge badge-success" id="connectionStatus">Đang kết nối Hub...</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive" style="height: 500px; overflow-y: auto;">
                        <table class="table table-hover mb-0">
                            <thead class="thead-light" style="position: sticky; top: 0; z-index: 1;">
                                <tr>
                                    <th style="width: 25%">Mã thiết bị</th>
                                    <th style="width: 15%">HĐH</th>
                                    <th style="width: 25%">Vị trí (GPS)</th>
                                    <th style="width: 15%">Giờ vào</th>
                                    <th style="width: 20%">Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody id="activeDeviceList">
                                <tr id="noDeviceRow">
                                    <td colspan="5" class="text-center text-muted py-5 mt-5">
                                        <i class="fas fa-spinner fa-spin mr-2"></i> Đang chờ kết nối từ ứng dụng Mobile...
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow border-bottom-danger h-100">
                <div class="card-header py-3 bg-dark d-flex justify-content-between align-items-center">
                    <h6 class="m-0 font-weight-bold text-white text-truncate">
                        <i class="fas fa-map-marked-alt text-warning mr-2"></i>Bản đồ Heatmap
                    </h6>
                </div>
                <div class="card-body p-0">
                    <div id="map" style="height: 500px; width: 100%; border-bottom-left-radius: 0.35rem; border-bottom-right-radius: 0.35rem;"></div>
                </div>
            </div>
        </div>

    </div>

    <div class="row mt-auto">
        <div class="col-12 mb-2">
            <div class="card shadow">
                <div class="card-body text-center py-3">
                    <div class="row align-items-center">
                        <div class="col-md-3">
                            <img class="img-fluid px-3" style="max-height: 120px;" src="~/img/undraw_posting_photo.svg" alt="...">
                        </div>
                        <div class="col-md-9 text-md-left">
                            <p class="text-gray-800 mb-1">
                                Hệ thống quản trị <strong>Taste Tour - Phố ẩm thực Vĩnh Khánh</strong>
                            </p>
                            <p class="mb-0 text-muted small">
                                Sinh viên thực hiện: <strong>Nguyễn Huỳnh Hoàng Vũ</strong> & <strong>Nguyễn Tấn Phát</strong> (ĐH Sài Gòn - SGU)
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div> 

<style>
    .blink_me { animation: blinker 1.5s linear infinite; }
    @@keyframes blinker { 50% { opacity: 0; } }
    #activeDeviceList tr { transition: background-color 1.5s ease; }
</style>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://leaflet.github.io/Leaflet.heat/dist/leaflet-heat.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

    <script>
        $(document).ready(function () {
            // 1. CẤU HÌNH BẢN ĐỒ VĨNH KHÁNH
            var map = L.map('map').setView([10.7600, 106.7050], 16);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(map);

            var heatPoints = [];
            var heatLayer = L.heatLayer(heatPoints, { radius: 25, blur: 15, maxZoom: 17 }).addTo(map);
            var deviceMarkers = {};

            // Track connectionId đã biết để tránh cộng đôi khi server gửi lại danh sách cũ
            var knownConnections = new Set();

            function updateDeviceCount() {
                $('#totalActiveDevices').text(knownConnections.size);
            }

            // 2. CẤU HÌNH SIGNALR
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/deviceHub")
                .build();

            // SỰ KIỆN MÁY VÀO (cũng dùng khi server replay danh sách cũ cho admin mới kết nối)
            connection.on("OnDeviceConnected", function (connectionId, deviceId, platform, joinTime, lat, lng) {
                // Nếu thiết bị này đã có trong bảng rồi (replay từ server) → bỏ qua
                if (knownConnections.has(connectionId)) return;
                knownConnections.add(connectionId);

                $('#noDeviceRow').remove();
                updateDeviceCount();
                $('#totalActiveDevices').addClass('text-success');
                setTimeout(() => $('#totalActiveDevices').removeClass('text-success'), 1000);

                var latLngText = "Đang lấy...";

                // Nếu có tọa độ thì vẽ lên bản đồ
                if (lat && lng) {
                    latLngText = lat.toFixed(5) + ", " + lng.toFixed(5);
                    heatPoints.push([lat, lng, 0.7]);
                    heatLayer.setLatLngs(heatPoints);
                    if (deviceMarkers[connectionId]) map.removeLayer(deviceMarkers[connectionId]);
                    deviceMarkers[connectionId] = L.circleMarker([lat, lng], { radius: 6, color: 'blue', fillColor: '#3388ff', fillOpacity: 1 }).addTo(map)
                        .bindPopup("Thiết bị: " + deviceId);
                }

                // Thêm dòng vào bảng (dùng CSS transition nhẹ thay vì flash mạnh)
                var isReplay = (joinTime !== "");
                var rowClass = isReplay ? "" : "bg-success text-white";
                var newRow = `
                    <tr id="${connectionId}" class="${rowClass}">
                        <td class="text-truncate" style="max-width: 150px;" title="${deviceId}"><strong>${deviceId}</strong></td>
                        <td><i class="fas fa-mobile-alt mr-2"></i>${platform}</td>
                        <td><code>${latLngText}</code></td>
                        <td>${joinTime}</td>
                        <td><span class="badge badge-light text-success font-weight-bold"><i class="fas fa-circle fa-xs mr-1"></i>Online</span></td>
                    </tr>
                `;
                $("#activeDeviceList").prepend(newRow);
                if (rowClass) {
                    setTimeout(() => $(`#${connectionId}`).removeClass("bg-success text-white"), 2000);
                }
            });

            // SỰ KIỆN CẬP NHẬT VỊ TRÍ (mobile navigate back → không tạo row mới, chỉ update marker)
            connection.on("OnDeviceLocationUpdated", function (connectionId, lat, lng) {
                if (!lat || !lng) return;
                // Cập nhật marker trên bản đồ
                if (deviceMarkers[connectionId]) {
                    deviceMarkers[connectionId].setLatLng([lat, lng]);
                } else {
                    deviceMarkers[connectionId] = L.circleMarker([lat, lng], { radius: 6, color: 'blue', fillColor: '#3388ff', fillOpacity: 1 }).addTo(map)
                        .bindPopup("Thiết bị: " + connectionId);
                }
                // Cập nhật heatmap
                heatPoints.push([lat, lng, 0.5]);
                heatLayer.setLatLngs(heatPoints);
                // Cập nhật tọa độ trong ô bảng nếu row đang tồn tại
                var row = $(`#${connectionId}`);
                if (row.length) {
                    row.find("code").text(lat.toFixed(5) + ", " + lng.toFixed(5));
                }
            });


            // SỰ KIỆN MÁY THOÁT
            connection.on("OnDeviceDisconnected", function (connectionId) {
                knownConnections.delete(connectionId);

                // Xóa marker trên bản đồ
                if (deviceMarkers[connectionId]) {
                    map.removeLayer(deviceMarkers[connectionId]);
                    delete deviceMarkers[connectionId];
                }

                var row = $(`#${connectionId}`);
                if (row.length) {
                    updateDeviceCount();
                    $('#totalActiveDevices').addClass('text-danger');
                    setTimeout(() => $('#totalActiveDevices').removeClass('text-danger'), 1000);

                    row.addClass("bg-danger text-white");
                    row.find(".badge").removeClass("badge-light text-success").addClass("badge-dark").text("Đã thoát");
                    setTimeout(() => {
                        row.fadeOut("slow", function() {
                            $(this).remove();
                            if ($('#activeDeviceList tr').length === 0) {
                                $('#activeDeviceList').html('<tr id="noDeviceRow"><td colspan="5" class="text-center text-muted py-5"><i class="fas fa-spinner fa-spin mr-2"></i> Đang chờ kết nối từ ứng dụng Mobile...</td></tr>');
                            }
                        });
                    }, 3000);
                }
            });

            connection.start().then(function () {
                console.log("SignalR Connected!");
                $("#connectionStatus").text("Hub & Map Ready").removeClass("badge-success").addClass("badge-primary");
            }).catch(function (err) {
                $("#connectionStatus").text("Lỗi kết nối").removeClass("badge-success").addClass("badge-danger");
                return console.error(err.toString());
            });

            // Sửa lỗi bản đồ bị co rút khi nằm trong lưới nhỏ
            setTimeout(function(){ map.invalidateSize()}, 400);
        });
    </script>
}
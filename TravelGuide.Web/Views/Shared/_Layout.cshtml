<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>HeriStep - Admin Dashboard</title>
    
    <link href="~/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
        <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i" rel="stylesheet">
        <link href="~/css/sb-admin-2.min.css" rel="stylesheet">

        </head>

        <body id="page-top">
            <div id="wrapper">

                <ul class="navbar-nav bg-gradient-primary sidebar sidebar-dark accordion" id="accordionSidebar">
                    <a class="sidebar-brand d-flex align-items-center justify-content-center" href="/">
                        <div class="sidebar-brand-icon rotate-n-15">
                            <i class="fas fa-map-marked-alt"></i>
                        </div>
                        <div class="sidebar-brand-text mx-3">HeriStep Admin</div>
                    </a>
                    <hr class="sidebar-divider my-0">

                    <li class="nav-item">
                        <a class="nav-link" href="/">
                            <i class="fas fa-fw fa-tachometer-alt"></i>
                            <span>Dashboard (Analytics)</span>
                        </a>
                    </li>
                    <hr class="sidebar-divider">
                    <div class="sidebar-heading">Quản lý nội dung</div>
    
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="POIs" asp-action="Index">
                            <i class="fas fa-fw fa-map-marker-alt"></i>
                            <span>Quản lý POI</span>
                        </a>
                    </li>
            
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Audios" asp-action="Index">
                            <i class="fas fa-fw fa-headphones"></i>
                            <span>Quản lý Audio</span>
                        </a>
                    </li>
            
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Tours" asp-action="Index">
                            <i class="fas fa-fw fa-route"></i>
                            <span>Quản lý Tour</span>
                        </a>
                    </li>
                </ul>
        
                <div id="content-wrapper" class="d-flex flex-column">
                    <div id="content">
                        <nav class="navbar navbar-expand navbar-light bg-white topbar mb-4 static-top shadow"></nav>

                        <div class="container-fluid">
                            @RenderBody()
                        </div>
                    </div>
                    <footer class="sticky-footer bg-white">
                        <div class="container my-auto">
                            <div class="copyright text-center my-auto">
                                <span>Đồ án .NET MAUI & MVC &copy; @DateTime.Now.Year</span>
                            </div>
                        </div>
                    </footer>
                </div>
            </div>

            <script src="~/vendor/jquery/jquery.min.js"></script>
            <script src="~/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
            <script src="~/js/sb-admin-2.min.js"></script>
            @await RenderSectionAsync("Scripts", required: false)
        </body>
    </html>
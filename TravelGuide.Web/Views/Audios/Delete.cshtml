@model TravelGuide.Web.Models.Audio
@{
    ViewData["Title"] = "Cập nhật Audio";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-9">
            <div class="card shadow border-0" style="border-radius: 25px; overflow: hidden;">
                
                <div class="card-header bg-white py-4 d-flex align-items-center" style="border-bottom: 2px solid #fff3cd;">
                    <div class="icon-circle bg-warning text-white mr-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px; border-radius: 15px; box-shadow: 0 5px 15px rgba(246, 194, 62, 0.3);">
                        <i class="fas fa-edit fa-lg text-dark"></i>
                    </div>
                    <h4 class="m-0 font-weight-bold text-dark">Cập nhật File Thuyết minh</h4>
                </div>
                
                <div class="card-body p-5 bg-light">
                    <form asp-action="Edit">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="FileUrl" />

                        <div class="mb-5 p-4 rounded-lg shadow-inner" style="background-color: #fff; border-radius: 20px; box-shadow: inset 0 2px 10px rgba(0,0,0,0.05); border: 1px solid #e1e5eb;">
                            <label class="font-weight-bold text-muted d-block text-center mb-3" style="font-size: 1.1rem; letter-spacing: 1px;">
                                <i class="fas fa-wave-square text-warning mr-2"></i>FILE ÂM THANH ĐANG GẮN
                            </label>
                            <div class="text-center">
                                @if (!string.IsNullOrEmpty(Model.FileUrl))
                                {
                                    <audio controls class="w-100" style="max-width: 500px;">
                                        <source src="@Model.FileUrl" type="audio/mpeg">
                                    </audio>
                                    <div class="mt-2 text-muted small text-break"><code>@Model.FileUrl</code></div>
                                }
                                else
                                {
                                    <div class="alert alert-danger rounded-pill d-inline-block px-4 py-2">
                                        <i class="fas fa-times-circle mr-2"></i>Bị lỗi hoặc chưa có file
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="form-group mb-4">
                            <label class="font-weight-bold h6 text-dark mb-2">Tiêu đề Audio (Giọng thuyết minh)</label>
                            <input asp-for="Title" class="form-control form-control-lg bg-white" placeholder="Ví dụ: Giọng thuyết minh tiếng Việt Quán ốc L..." required />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="row mb-5">
                            <div class="col-md-6 form-group">
                                <label class="font-weight-bold h6 text-dark mb-2">Thuộc Địa điểm (POI)</label>
                                <select asp-for="PoiId" class="form-control form-control-lg bg-white" asp-items="ViewBag.PoiId"></select>
                            </div>
                            <div class="col-md-6 form-group">
                                <label class="font-weight-bold h6 text-dark mb-2">Ngôn ngữ</label>
                                <select asp-for="Language" class="form-control form-control-lg bg-white">
                                    <option value="Tiếng Việt (VN)">Tiếng Việt (VN)</option>
                                    <option value="English (EN)">English (EN)</option>
                                </select>
                            </div>
                        </div>

                        <hr style="border-top: 2px dashed #e1e5eb;" />
                        
                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-secondary btn-lg" style="opacity: 0.8;">
                                <i class="fas fa-arrow-left mr-2"></i>Hủy bỏ
                            </a>
                            <button type="submit" class="btn btn-warning btn-lg text-dark font-weight-bold" style="background: linear-gradient(45deg, #f6c23e, #f4b400); border: none;">
                                <i class="fas fa-save mr-2"></i>Lưu thay đổi ngay
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
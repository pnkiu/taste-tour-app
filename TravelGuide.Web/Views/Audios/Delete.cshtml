@model TravelGuide.Web.Models.Audio
@{
    ViewData["Title"] = "Xóa Audio";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-9">
            <div class="card shadow border-0" style="border-radius: 25px; overflow: hidden;">
                
                <div class="card-header bg-white py-4 d-flex align-items-center" style="border-bottom: 2px solid #f8d7da;">
                    <div class="icon-circle bg-danger text-white mr-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px; border-radius: 15px; box-shadow: 0 5px 15px rgba(220, 53, 69, 0.3);">
                        <i class="fas fa-trash fa-lg text-white"></i>
                    </div>
                    <h4 class="m-0 font-weight-bold text-danger">Xóa File Thuyết minh</h4>
                </div>
                
                <div class="card-body p-5 bg-light">
                    <div class="alert alert-danger mb-4" style="border-radius: 15px;">
                        <i class="fas fa-exclamation-triangle mr-2"></i> <strong>Cảnh báo:</strong> Bạn có chắc chắn muốn xóa file âm thanh này không? Hành động này không thể hoàn tác!
                    </div>

                    <div class="mb-5 p-4 rounded-lg shadow-inner" style="background-color: #fff; border-radius: 20px; box-shadow: inset 0 2px 10px rgba(0,0,0,0.05); border: 1px solid #e1e5eb;">
                        <label class="font-weight-bold text-muted d-block text-center mb-3" style="font-size: 1.1rem; letter-spacing: 1px;">
                            <i class="fas fa-wave-square text-danger mr-2"></i>FILE ÂM THANH SẼ BỊ XÓA
                        </label>
                        <div class="text-center">
                            @if (!string.IsNullOrEmpty(Model.FileUrl))
                            {
                                <audio controls class="w-100" style="max-width: 500px;">
                                    <source src="@Model.FileUrl" type="audio/mpeg">
                                </audio>
                                <div class="mt-2 text-muted small text-break"><code>@Model.FileUrl</code></div>
                            }
                            else
                            {
                                <div class="alert alert-warning rounded-pill d-inline-block px-4 py-2">
                                    <i class="fas fa-times-circle mr-2"></i>Chưa có file âm thanh
                                </div>
                            }
                        </div>
                    </div>

                    <div class="px-3 mb-4">
                        <dl class="row">
                            <dt class="col-sm-4 font-weight-bold h6 text-dark mb-3">Tiêu đề Audio:</dt>
                            <dd class="col-sm-8 h6 text-muted mb-3">@Model.Title</dd>

                            <dt class="col-sm-4 font-weight-bold h6 text-dark mb-3">Thuộc Địa điểm:</dt>
                            <dd class="col-sm-8 h6 text-muted mb-3">@(Model.POI?.Name ?? "Chưa xác định")</dd>

                            <dt class="col-sm-4 font-weight-bold h6 text-dark mb-3">Ngôn ngữ:</dt>
                            <dd class="col-sm-8 h6 text-muted mb-3">@Model.Language</dd>
                        </dl>
                    </div>

                    <hr style="border-top: 2px dashed #e1e5eb;" />
                    
                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        
                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-secondary btn-lg" style="opacity: 0.8;">
                                <i class="fas fa-arrow-left mr-2"></i>Hủy bỏ
                            </a>
                            <button type="submit" class="btn btn-danger btn-lg text-white font-weight-bold" style="background: linear-gradient(45deg, #e74a3b, #e02d1b); border: none;">
                                <i class="fas fa-trash-alt mr-2"></i>Xác nhận Xóa
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
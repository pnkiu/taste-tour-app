@model IEnumerable<TravelGuide.Web.Models.Audio>

@{
    ViewData["Title"] = "Quản lý Audio";
}

<h1 class="h3 mb-2 text-gray-800">Quản lý File Thuyết minh (Audio)</h1>
<p class="mb-4">Danh sách các file âm thanh sẽ tự động phát khi khách du lịch đi vào vùng Geofence của địa điểm.</p>

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
        <h6 class="m-0 font-weight-bold text-primary">Dữ liệu Audio</h6>
        <a asp-action="Create" class="btn btn-sm btn-success shadow-sm">
            <i class="fas fa-plus fa-sm text-white-50"></i> Thêm file mới
        </a>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover" id="dataTable" width="100%" cellspacing="0">
                <thead class="thead-light">
                    <tr>
                        <th>Tiêu đề file</th>
                        <th>Thuộc địa điểm (POI)</th>
                        <th>Ngôn ngữ</th>
                        <th>Nghe thử</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="font-weight-bold text-dark align-middle">@item.Title</td>
                            <td class="align-middle">
                                <span class="badge badge-primary" style="font-size: 14px;">@item.POI?.Name</span>
                            </td>
                            <td class="align-middle">@item.Language</td>
                            <td class="align-middle text-center">
                                @if (!string.IsNullOrEmpty(item.FileUrl))
                                {
                                    <audio controls style="height: 35px; width: 220px; outline: none;">
                                        <source src="@item.FileUrl" type="audio/mpeg">
                                        Trình duyệt không hỗ trợ.
                                    </audio>
                                }
                                else
                                {
                                    <span class="text-danger">Lỗi file</span>
                                }
                            </td>
                            <td class="align-middle">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-circle btn-sm" title="Sửa">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-circle btn-sm" title="Xem chi tiết">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-circle btn-sm" title="Xóa">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/vendor/datatables/jquery.dataTables.min.js"></script>
    <script src="~/vendor/datatables/dataTables.bootstrap4.min.js"></script>
    <link href="~/vendor/datatables/dataTables.bootstrap4.min.css" rel="stylesheet">

        <script>
            $(document).ready(function() {
                // Biến bảng thành DataTables và Việt hóa
                $('#dataTable').DataTable({
                    "language": {
                        "url": "//cdn.datatables.net/plug-ins/1.10.24/i18n/Vietnamese.json"
                    }
                });
            });
        </script>
    }
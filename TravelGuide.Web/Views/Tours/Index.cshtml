@model IEnumerable<TravelGuide.Web.Models.Tour>

@{
    ViewData["Title"] = "Quản lý Hành trình (Tour)";
}

<h1 class="h3 mb-2 text-gray-800">Quản lý Hành trình (Tours)</h1>
<p class="mb-4">Danh sách các tuyến đường tham quan ẩm thực được thiết kế sẵn dành cho du khách.</p>

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
        <h6 class="m-0 font-weight-bold text-primary">Dữ liệu Hành trình</h6>
        <a asp-action="Create" class="btn btn-sm btn-success shadow-sm">
            <i class="fas fa-plus fa-sm text-white-50"></i> Thêm Tour mới
        </a>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover" id="dataTable" width="100%" cellspacing="0">
                <thead class="thead-light">
                    <tr>
                        <th style="width: 100px;">Ảnh bìa</th>
                        <th>Tên Hành trình</th>
                        <th>Thời gian</th>
                        <th>Quãng đường</th>
                        <th style="width: 150px;">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="align-middle text-center">
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" alt="Cover" style="height: 50px; width: 80px; border-radius: 5px; object-fit: cover;" />
                                }
                                else
                                {
                                    <span class="badge badge-secondary">Chưa có ảnh</span>
                                }
                            </td>
                            <td class="font-weight-bold text-primary align-middle">@item.Name</td>
                            <td class="align-middle">@item.Duration</td>
                            <td class="align-middle">@item.Distance</td>
                            <td class="align-middle text-center">
                                
                                <a asp-action="ManageRoute" asp-route-id="@item.Id" class="btn btn-success btn-circle btn-sm shadow-sm" title="Thiết kế lộ trình (Thêm Quán ăn)">
                                    <i class="fas fa-map-signs"></i>
                                </a>

                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-circle btn-sm" title="Sửa"><i class="fas fa-edit"></i></a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-circle btn-sm" title="Chi tiết"><i class="fas fa-eye"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-circle btn-sm" title="Xóa"><i class="fas fa-trash"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/vendor/datatables/jquery.dataTables.min.js"></script>
    <script src="~/vendor/datatables/dataTables.bootstrap4.min.js"></script>
    <link href="~/vendor/datatables/dataTables.bootstrap4.min.css" rel="stylesheet">
        <script>
            $(document).ready(function() {
                $('#dataTable').DataTable({
                    "language": { "url": "//cdn.datatables.net/plug-ins/1.10.24/i18n/Vietnamese.json" }
                });
            });
        </script>
    }
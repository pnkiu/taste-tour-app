@model TravelGuide.Web.Models.Tour

@{
    ViewData["Title"] = "Cập nhật Hành trình";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Cập nhật Hành trình: <span class="text-primary font-weight-bold">@Model.Name</span></h1>
    <a asp-action="Index" class="d-none d-sm-inline-block btn btn-sm btn-secondary shadow-sm">
        <i class="fas fa-arrow-left fa-sm text-white-50"></i> Quay lại danh sách
    </a>
</div>

<div class="row">
    <div class="col-xl-8 col-lg-7">
        <div class="card shadow mb-4 border-bottom-primary">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-edit"></i> Thông tin chi tiết Hành trình</h6>
            </div>
            <div class="card-body">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="form-group">
                        <label asp-for="Name" class="control-label font-weight-bold text-dark">Tên Hành trình</label>
                        <input asp-for="Name" class="form-control" placeholder="VD: Khám phá Ốc Vĩnh Khánh..." />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Description" class="control-label font-weight-bold text-dark">Mô tả hấp dẫn</label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="Viết vài dòng giới thiệu để thu hút du khách..."></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Duration" class="control-label font-weight-bold text-dark">Thời gian dự kiến</label>
                                <div class="input-group">
                                    <div class="input-group-prepend"><span class="input-group-text bg-light"><i class="fas fa-clock text-primary"></i></span></div>
                                    <input asp-for="Duration" class="form-control" placeholder="VD: 2 giờ" readonly />
                                </div>
                                <span asp-validation-for="Duration" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Distance" class="control-label font-weight-bold text-dark">Tổng quãng đường</label>
                                <div class="input-group">
                                    <div class="input-group-prepend"><span class="input-group-text bg-light"><i class="fas fa-route text-success"></i></span></div>
                                    <input asp-for="Distance" class="form-control" placeholder="VD: 1.5 km" readonly />
                                </div>
                                <span asp-validation-for="Distance" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="ImageUrl" class="control-label font-weight-bold text-dark">Link ảnh bìa (URL)</label>
                        <div class="input-group">
                            <div class="input-group-prepend"><span class="input-group-text bg-light"><i class="fas fa-link text-info"></i></span></div>
                            <input asp-for="ImageUrl" id="ImageUrlInput" class="form-control" placeholder="Dán link hình ảnh vào đây..." />
                        </div>
                        <span asp-validation-for="ImageUrl" class="text-danger"></span>
                    </div>

                    <hr>
                    <div class="form-group text-center mt-4 mb-0">
                        <button type="submit" class="btn btn-primary btn-icon-split shadow-sm px-4">
                            <span class="icon text-white-50"><i class="fas fa-save"></i></span>
                            <span class="text font-weight-bold">Lưu thay đổi</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-xl-4 col-lg-5">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-success"><i class="fas fa-image"></i> Xem trước Ảnh bìa</h6>
            </div>
            <div class="card-body text-center bg-gray-100">
                <img id="ImagePreview" src="@(!string.IsNullOrEmpty(Model.ImageUrl) ? Model.ImageUrl : "https://via.placeholder.com/400x300?text=Chua+co+anh")"
                     alt="Preview" class="img-fluid rounded shadow-sm mb-3" style="max-height: 250px; object-fit: cover; width: 100%; border: 3px solid white;" />
                <p class="text-muted small mb-0"><i class="fas fa-mobile-alt"></i> Hình ảnh này sẽ hiển thị làm Banner trên ứng dụng .NET MAUI của du khách.</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // JS nhỏ để tự động đổi ảnh xem trước ngay khi bạn dán link mới vào ô Input
        $(document).ready(function () {
            $('#ImageUrlInput').on('input', function () {
                var url = $(this).val();
                if (url) {
                    $('#ImagePreview').attr('src', url);
                } else {
                    $('#ImagePreview').attr('src', 'https://via.placeholder.com/400x300?text=Chua+co+anh');
                }
            });
        });
    </script>
}